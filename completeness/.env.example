# Copie para .env e preencha. O .env NUNCA vai para o repositório.

# --- Fonte de dados do app --------------------------------------------------
# "local"    -> lê os CSVs gerados pela rotina diária nesta pasta (uso no PC)
# "supabase" -> lê as tabelas comp_* do Postgres (app na nuvem)
FONTE_DADOS=local

# --- Supabase ---------------------------------------------------------------
# Postgres: use a string do POOLER (Settings > Database > Connection pooling).
# DATABASE_URL=postgresql+psycopg2://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Storage das miniaturas (bucket privado). A service_role key fica só no seu PC
# e nos Secrets do Streamlit Cloud.
# SUPABASE_URL=https://SEU_REF.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=comp-thumbs

# --- Notificação no Teams ---------------------------------------------------
# URL do fluxo (Workflow) que posta no canal Ecom + CRM.
# Sem ela, notifica_teams.py só imprime a mensagem.
# TEAMS_WEBHOOK_URL=
# Formato do corpo: "cartao" (fluxo criado pelo Teams, padrão) ou "texto"
# (fluxo montado à mão no Power Automate com o gatilho HTTP).
# TEAMS_FORMATO=cartao

# --- Pastas das fontes (só se os caminhos padrão mudarem) -------------------
# SOUQ_DADOS_DIR=C:\Users\LeandroDias\Projetos\dados
# SOUQ_PRODUTO_DIR=
# SOUQ_FOTOS_DIR=

# Data de referência ("hoje"). Vazio = data atual.
DATA_REFERENCIA=
